a = input("enter the password: ")
up = 0
low = 0
sp = 0
dig = 0

if len(a) > 7:
    for i in a:
        if i.isupper():
            up = up+1
        elif i.islower():
            low = low+1
        elif i.isdigit():
            dig = dig+1
    else:
        sp =sp+1
        if up>0 and low>0 and dig>0 and sp>0:
            print("Strong password")
        else:
            print("week password")
else:
    print("Invalid password")
